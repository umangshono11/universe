<div class="kdh-modal-backdrop" id="search-modal" style="display:none;" role="dialog" aria-modal="true" aria-label="Search">
  <div style="width:100%;max-width:680px;margin:0 auto;padding:0 1rem;">
    <div style="display:flex;align-items:center;gap:1rem;background:rgba(18,18,20,0.95);border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:1rem 1.25rem;">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="search-input" placeholder="Search products, collections..." autocomplete="off"
        style="flex:1;background:none;border:none;outline:none;color:#fff;font-size:1.1rem;font-family:'Outfit',sans-serif;letter-spacing:0.04em;">
      <button id="search-close" aria-label="Close search" style="color:rgba(255,255,255,0.5);font-size:1.4rem;line-height:1;">&#x2715;</button>
    </div>
    <div id="search-results" style="margin-top:1rem;display:flex;flex-direction:column;gap:0.5rem;max-height:60vh;overflow-y:auto;"></div>
  </div>
</div>
