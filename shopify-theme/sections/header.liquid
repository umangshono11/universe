<nav class="kdh-navbar" id="kdh-navbar" aria-label="Main Navigation">
  <div class="kdh-nav-left" style="pointer-events:auto">
    <button class="nav-menu-btn" id="menu-btn" aria-label="Toggle navigation menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="kdh-nav-center">
    <a href="{{ routes.root_url }}" class="kdh-nav-logo-link" aria-label="EKKAYI">
      {% if settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: 280 }}"
             alt="{{ shop.name }}"
             style="height:auto;width:140px;max-height:44px;object-fit:contain;filter:drop-shadow(0 2px 8px rgba(0,0,0,0.8))">
      {% else %}
        <img src="{{ 'ekkayi-logo.svg' | asset_url }}"
             alt="{{ shop.name | default: 'EKKAYI' }}"
             style="height:auto;width:140px;max-height:44px;object-fit:contain;filter:drop-shadow(0 2px 8px rgba(0,0,0,0.8))">
      {% endif %}
    </a>
  </div>
  <div class="kdh-nav-right" style="pointer-events:auto;display:flex;align-items:center;gap:0.75rem;">
    <button class="kdh-nav-icon-btn" id="audio-btn" title="Play Ambient Sound" aria-label="Toggle ambient sound">
      <svg id="audio-icon-off" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
      <svg id="audio-icon-on" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
    </button>
    <button class="kdh-nav-icon-btn" id="search-btn" title="Search" aria-label="Open search">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </button>
    <a href="{{ routes.cart_url }}" class="kdh-nav-icon-btn" id="cart-btn" title="Cart" aria-label="Shopping cart" style="position:relative;text-decoration:none">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="cart-count-badge" id="cart-badge" style="display:none">{{ cart.item_count }}</span>
    </a>
  </div>
</nav>

<style>
.kdh-navbar{position:fixed;top:0;left:0;width:100%;z-index:60;display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem;pointer-events:none;}
.kdh-nav-left,.kdh-nav-right{pointer-events:auto;}
.kdh-nav-center{position:absolute;left:50%;transform:translateX(-50%);pointer-events:auto;}
.kdh-nav-logo-link{display:inline-block;transition:transform 0.3s ease;}
.kdh-nav-logo-link:hover{transform:scale(1.05);}
.kdh-nav-icon-btn{padding:0.55rem;border-radius:50%;background-color:rgba(0,0,0,0.4);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.12);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.3s ease;}
.kdh-nav-icon-btn:hover{background:rgba(0,0,0,0.8);}
.kdh-nav-icon-btn.audio-on{color:#c5a75c;}
.cart-count-badge{position:absolute;top:-4px;right:-4px;background:#c5a75c;color:#000;font-size:0.65rem;font-weight:700;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,0.5);}
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {"type": "image_picker", "id": "logo", "label": "Logo image"}
  ]
}
{% endschema %}

