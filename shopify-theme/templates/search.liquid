<div style="min-height:100vh;background:#000;padding-top:6rem;padding-bottom:5rem;">
  <div class="kdh-container">
    <div style="text-align:center;margin-bottom:3rem;">
      <h1 class="section-title">Search Results</h1>
      {% if search.performed %}
        <p class="section-subtitle">{{ search.results_count }} results found for "{{ search.terms }}"</p>
      {% endif %}
    </div>

    {% if search.performed %}
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:2.5rem 1.75rem;">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            <div style="display:flex;flex-direction:column;align-items:center;text-align:center;">
              <div onclick="location.href='{{ item.url }}'" style="width:100%;aspect-ratio:4/3;position:relative;border-radius:12px;background:radial-gradient(circle at center,rgba(255,255,255,0.05) 0%,rgba(10,10,12,0.9) 75%);border:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;padding:1.25rem;cursor:pointer;">
                {% if item.featured_image %}
                  <img src="{{ item.featured_image | image_url: width: 600 }}" alt="{{ item.title }}" style="width:100%;height:100%;object-fit:contain;">
                {% endif %}
              </div>
              <div style="margin-top:1rem;">
                <h3 onclick="location.href='{{ item.url }}'" style="font-size:0.9rem;font-weight:700;color:#fff;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;">{{ item.title }}</h3>
                <p style="font-size:0.72rem;color:var(--text-muted);margin-top:0.2rem;">{{ item.type }}</p>
                <a href="{{ item.url }}" class="btn-outline" style="margin-top:0.75rem;font-size:0.7rem;padding:4px 12px;">View Piece</a>
              </div>
            </div>
          {% else %}
            <div style="background:rgba(16,16,18,0.8);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:1.5rem;">
              <h3 style="font-size:1rem;color:#fff;margin-bottom:0.5rem;"><a href="{{ item.url }}" style="color:#fff;">{{ item.title }}</a></h3>
              <p style="font-size:0.8rem;color:var(--text-secondary);line-height:1.6;">{{ item.content | strip_html | truncatewords: 25 }}</p>
              <a href="{{ item.url }}" style="font-size:0.75rem;color:var(--gold);display:inline-block;margin-top:0.75rem;">Read More &rarr;</a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
