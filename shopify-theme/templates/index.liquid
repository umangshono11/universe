<div style="position:fixed;inset:0;width:100vw;height:100vh;background:radial-gradient(circle at 50% 50%, rgba(45, 76, 58, 0.45) 0%, rgba(20, 36, 28, 0.65) 45%, #070908 85%);overflow:hidden;">
  <div id="three-globe-mount" style="position:absolute;inset:0;width:100%;height:100%;"></div>
  <div class="zoom-cinematic-overlay" id="zoom-overlay"></div>
  
  <!-- Live Tooltip -->
  <div id="globe-tooltip" class="sphere-tooltip" style="position:fixed;pointer-events:none;z-index:100;display:none;background:rgba(18, 24, 21, 0.95);backdrop-filter:blur(16px);border:1px solid rgba(197, 167, 92, 0.4);border-radius:10px;padding:12px 18px;box-shadow:0 15px 35px rgba(0,0,0,0.85);">
    <div style="font-size:0.68rem;color:var(--terracotta);font-weight:700;letter-spacing:0.12em;text-transform:uppercase;" id="tt-group"></div>
    <div style="font-family:var(--font-serif);font-size:1.15rem;font-weight:600;color:#FFFFFF;margin:3px 0;" id="tt-name"></div>
    <div style="display:flex;align-items:center;gap:0.6rem;margin-top:4px;">
      <span style="font-size:0.95rem;font-weight:700;color:var(--soft-parchment);" id="tt-price"></span>
      <span style="font-size:0.68rem;color:var(--gold);letter-spacing:0.08em;text-transform:uppercase;background:rgba(197,167,92,0.15);padding:2px 8px;border-radius:10px;">Inspect Piece &rarr;</span>
    </div>
  </div>

  <!-- Bottom Floating Instruction Pill -->
  <div style="position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);z-index:30;pointer-events:none;text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:0.6rem;padding:8px 20px;border-radius:30px;background:rgba(18, 24, 21, 0.85);backdrop-filter:blur(16px);border:1px solid rgba(197, 167, 92, 0.35);box-shadow:0 8px 30px rgba(0,0,0,0.6);">
      <span style="width:6px;height:6px;border-radius:50%;background:#C5A75C;display:inline-block;box-shadow:0 0 8px #C5A75C;"></span>
      <span style="font-size:0.72rem;letter-spacing:0.2em;font-weight:600;color:var(--soft-parchment);text-transform:uppercase;">Drag to Rotate &bull; Click Any Piece to Inspect</span>
    </div>
  </div>

  <!-- Orbit Controls (Bottom Right) -->
  <div style="position:absolute;bottom:2rem;right:2rem;z-index:40;display:flex;flex-direction:column;gap:0.5rem;">
    <button id="globe-zoom-in" style="width:38px;height:38px;border-radius:50%;background:rgba(18, 24, 21, 0.85);backdrop-filter:blur(12px);border:1px solid rgba(255, 255, 255, 0.2);color:#FFFFFF;display:flex;align-items:center;justify-content:center;cursor:pointer;" title="Zoom In">+</button>
    <button id="globe-zoom-out" style="width:38px;height:38px;border-radius:50%;background:rgba(18, 24, 21, 0.85);backdrop-filter:blur(12px);border:1px solid rgba(255, 255, 255, 0.2);color:#FFFFFF;display:flex;align-items:center;justify-content:center;cursor:pointer;" title="Zoom Out">&minus;</button>
    <button id="globe-rotate-toggle" style="width:38px;height:38px;border-radius:50%;background:rgba(18, 24, 21, 0.85);backdrop-filter:blur(12px);border:1px solid rgba(255, 255, 255, 0.2);color:var(--gold);display:flex;align-items:center;justify-content:center;cursor:pointer;" title="Pause / Auto-Rotate">&#10074;&#10074;</button>
    <button id="globe-reset-view" style="width:38px;height:38px;border-radius:50%;background:rgba(18, 24, 21, 0.85);backdrop-filter:blur(12px);border:1px solid rgba(255, 255, 255, 0.2);color:#FFFFFF;display:flex;align-items:center;justify-content:center;cursor:pointer;" title="Reset Orbit View">&#8635;</button>
  </div>
</div>

{% comment %}Safely inject real furniture product data with fallback default products{% endcomment %}
