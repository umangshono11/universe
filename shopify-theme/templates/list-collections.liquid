<div style="min-height:100vh;background:linear-gradient(180deg, #F0E8DD 0%, #F8F5EE 40%, #EAE0CD 100%);color:#0A0A0A;padding-top:6.5rem;padding-bottom:6rem;">
  <div class="kdh-container">
    <div style="text-align:center;margin-bottom:3rem;">
      <h1 style="font-family:var(--font-serif);font-size:clamp(2.2rem, 4vw, 3.2rem);font-weight:500;color:var(--ekkayi-forest);letter-spacing:0.06em;text-transform:uppercase;display:inline-block;padding-bottom:0.75rem;border-bottom:2px solid var(--terracotta);">Furniture Collections</h1>
      <p style="color:#4A504C;font-size:1rem;margin-top:1rem;letter-spacing:0.02em;max-width:680px;margin-inline:auto;line-height:1.7;">Explore artisanal living room sofas, handcrafted solid teak dining sanctuaries, and upholstered bedroom suites designed by EKKAYI.</p>
    </div>

    <!-- Category Pills -->
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:0.65rem;margin-bottom:3.5rem;">
      <button class="col-filter-btn active" data-filter="all" style="padding:0.5rem 1.25rem;font-size:0.76rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;border-radius:30px;border:1px solid var(--ekkayi-forest);background:var(--ekkayi-forest);color:#FFFFFF;cursor:pointer;transition:all 0.25s ease;">All Collections</button>
      <button class="col-filter-btn" data-filter="sofas" style="padding:0.5rem 1.25rem;font-size:0.76rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;border-radius:30px;border:1px solid rgba(45,76,58,0.2);background:#FFFFFF;color:var(--ekkayi-forest);cursor:pointer;transition:all 0.25s ease;">Sofas & Recliners</button>
      <button class="col-filter-btn" data-filter="dining" style="padding:0.5rem 1.25rem;font-size:0.76rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;border-radius:30px;border:1px solid rgba(45,76,58,0.2);background:#FFFFFF;color:var(--ekkayi-forest);cursor:pointer;transition:all 0.25s ease;">Dining Sanctuaries</button>
      <button class="col-filter-btn" data-filter="bedroom" style="padding:0.5rem 1.25rem;font-size:0.76rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;border-radius:30px;border:1px solid rgba(45,76,58,0.2);background:#FFFFFF;color:var(--ekkayi-forest);cursor:pointer;transition:all 0.25s ease;">Bedroom Suites</button>
      <button class="col-filter-btn" data-filter="tables" style="padding:0.5rem 1.25rem;font-size:0.76rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;border-radius:30px;border:1px solid rgba(45,76,58,0.2);background:#FFFFFF;color:var(--ekkayi-forest);cursor:pointer;transition:all 0.25s ease;">Living Tables</button>
      <button class="col-filter-btn" data-filter="storage" style="padding:0.5rem 1.25rem;font-size:0.76rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;border-radius:30px;border:1px solid rgba(45,76,58,0.2);background:#FFFFFF;color:var(--ekkayi-forest);cursor:pointer;transition:all 0.25s ease;">Storage & Credenzas</button>
    </div>

    <!-- Collections Grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:2.5rem 2rem;" id="collections-grid">
      {% for collection in collections %}
        {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
        {% assign year = collection.metafields.kdh.year | default: '2025' %}
        {% assign collab = collection.metafields.kdh.collaborator | default: 'EKKAYI Atelier' %}
        {% assign col_type = collection.handle %}
        <div class="kdh-col-card" 
             data-filter="{% if col_type contains 'sofa' or col_type contains 'living' %}sofas{% elsif col_type contains 'dining' %}dining{% elsif col_type contains 'bed' %}bedroom{% elsif col_type contains 'table' %}tables{% else %}storage{% endif %}"
             style="background:#FFFFFF;border:1px solid rgba(45,76,58,0.15);border-radius:16px;box-shadow:0 10px 30px rgba(45,76,58,0.06);overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;transition:all 0.3s ease;">
          <div onclick="location.href='/collections/{{ collection.handle }}'"
               style="width:100%;height:240px;position:relative;background:#F0E8DD;display:flex;align-items:center;justify-content:center;overflow:hidden;cursor:pointer;">
            {% if collection.image %}
              <img src="{{ collection.image | image_url: width: 700 }}" alt="{{ collection.title }}"
                   style="width:100%;height:100%;object-fit:cover;transition:transform 0.45s cubic-bezier(0.16,1,0.3,1);" class="kdh-col-img">
            {% else %}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#6B6965;font-size:0.85rem;letter-spacing:0.12em;font-weight:600;">{{ collection.title }}</div>
            {% endif %}
            <span style="position:absolute;bottom:12px;left:14px;background:rgba(45,76,58,0.85);color:#FFFFFF;padding:3px 10px;border-radius:20px;font-size:0.68rem;letter-spacing:0.12em;font-weight:700;">{{ year }} COLLECTION</span>
          </div>

          <div style="padding:1.5rem;text-align:left;">
            <span style="font-size:0.7rem;color:var(--terracotta);letter-spacing:0.14em;text-transform:uppercase;font-weight:700;">{{ collab }}</span>
            <h3 onclick="location.href='/collections/{{ collection.handle }}'" style="font-family:var(--font-serif);font-size:1.25rem;font-weight:600;color:var(--ekkayi-forest);letter-spacing:0.04em;text-transform:uppercase;margin:0.35rem 0 0.5rem;cursor:pointer;">{{ collection.title }}</h3>
            <p style="font-size:0.84rem;color:#555A56;line-height:1.6;margin-bottom:1.25rem;">{{ collection.description | strip_html | truncate: 110 | default: 'Artisanal luxury furniture handcrafted with natural materials and modern architecture.' }}</p>

            <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(45,76,58,0.1);padding-top:1rem;">
              <a href="/collections/{{ collection.handle }}" style="font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--ekkayi-forest);text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
                Explore Pieces &rarr;
              </a>
              <span style="font-size:0.74rem;color:#7A807C;font-weight:500;">{{ collection.products_count | default: 8 }} Designs</span>
            </div>
          </div>
        </div>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</div>
<style>
.kdh-col-card:hover{transform:translateY(-4px);box-shadow:0 20px 40px rgba(45,76,58,0.12);border-color:var(--ekkayi-forest);}
.kdh-col-card:hover .kdh-col-img{transform:scale(1.06);}
</style>
