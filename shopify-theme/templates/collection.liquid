<div style="min-height:100vh;background:linear-gradient(180deg, #F0E8DD 0%, #F8F5EE 40%, #EAE0CD 100%);color:#0A0A0A;padding-top:6.5rem;padding-bottom:6rem;">
  <div class="kdh-container">
    <div style="margin-bottom:2rem;">
      <a href="/collections" style="display:inline-flex;align-items:center;gap:0.5rem;color:var(--ekkayi-forest);font-size:0.8rem;letter-spacing:0.12em;font-weight:700;text-transform:uppercase;text-decoration:none;transition:color 0.2s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        &larr; Back to All Collections
      </a>
    </div>

    <!-- Collection Header -->
    <div style="display:flex;flex-direction:column;align-items:center;text-align:center;border-bottom:1px solid rgba(45,76,58,0.15);padding-bottom:2.5rem;margin-bottom:3.5rem;">
      <img src="{{ 'ekkayi-nav-logo-green.svg' | asset_url }}" alt="EKKAYI" style="height:36px;width:auto;object-fit:contain;margin-bottom:1.5rem;">
      <span style="font-size:0.72rem;color:var(--terracotta);letter-spacing:0.16em;text-transform:uppercase;font-weight:700;">EKKAYI ARTISANAL SERIES</span>
      <h1 style="font-family:var(--font-serif);font-size:clamp(2rem,3.5vw,2.8rem);font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:var(--ekkayi-forest);margin:0.4rem 0 0.8rem;">{{ collection.title }}</h1>
      <p style="font-size:0.95rem;color:#4A504C;max-width:650px;line-height:1.7;">{{ collection.description | default: 'Meticulously engineered and hand-finished with sustainable hardwoods, bespoke upholstery, and architectural craftsmanship.' }}</p>
    </div>

    <!-- Products Grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:2.5rem 2rem;">
      {% for product in collection.products %}
      <div style="background:#FFFFFF;border:1px solid rgba(45,76,58,0.15);border-radius:16px;box-shadow:0 10px 30px rgba(45,76,58,0.06);overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;transition:all 0.3s ease;" class="kdh-prod-card">
        <div onclick="location.href='/products/{{ product.handle }}'"
             style="width:100%;height:250px;position:relative;background:#F0E8DD;display:flex;align-items:center;justify-content:center;overflow:hidden;cursor:pointer;">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title }}"
                 style="width:100%;height:100%;object-fit:cover;transition:transform 0.45s cubic-bezier(0.16,1,0.3,1);" class="kdh-pi">
          {% endif %}
          {% if product.compare_at_price > product.price %}
            <span style="position:absolute;top:12px;left:14px;background:var(--terracotta);color:#FFFFFF;padding:3px 8px;border-radius:4px;font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;">Special Offer</span>
          {% endif %}
        </div>

        <div style="padding:1.5rem;text-align:left;">
          <span style="font-size:0.68rem;color:var(--terracotta);letter-spacing:0.12em;text-transform:uppercase;font-weight:700;">{{ product.type | default: 'Furniture' }}</span>
          <h3 onclick="location.href='/products/{{ product.handle }}'" style="font-family:var(--font-serif);font-size:1.15rem;font-weight:600;color:var(--ekkayi-forest);letter-spacing:0.02em;margin:0.35rem 0 0.5rem;cursor:pointer;">{{ product.title }}</h3>

          <div style="display:flex;align-items:baseline;gap:0.75rem;margin-bottom:1.25rem;">
            <span style="font-size:1.1rem;font-weight:700;color:var(--charred-black);">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span style="font-size:0.85rem;color:#8A8D8B;text-decoration:line-through;">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>

          <div style="border-top:1px solid rgba(45,76,58,0.1);padding-top:1rem;display:flex;align-items:center;justify-content:space-between;">
            <a href="/products/{{ product.handle }}" style="font-size:0.75rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--ekkayi-forest);text-decoration:none;">
              View Specifications &rarr;
            </a>
            <span style="font-size:0.7rem;color:var(--ekkayi-forest);background:rgba(45,76,58,0.08);padding:3px 8px;border-radius:4px;font-weight:600;">In Stock</span>
          </div>
        </div>
      </div>
      {% else %}
        <p style="color:#555A56;grid-column:1/-1;text-align:center;padding:4rem;">No products found in this collection.</p>
      {% endfor %}
    </div>
  </div>
</div>
<style>
.kdh-prod-card:hover{transform:translateY(-4px);box-shadow:0 20px 40px rgba(45,76,58,0.12);border-color:var(--ekkayi-forest);}
.kdh-prod-card:hover .kdh-pi{transform:scale(1.06);}
</style>
